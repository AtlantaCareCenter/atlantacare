---
import Buttons from './Buttons.astro';
import { md, mdInline } from '../lib/md';
const { heading, text, button_label, button_url, buttons } = Astro.props;
const label = button_label || 'Book Now';
---
<section class="section callout">
  <div class="container inner">
    <h2 set:html={mdInline(heading)} />
    {text && <div class="prose" set:html={md(text)} />}
    <Buttons label={label} url={button_url} more={buttons} />
  </div>
</section>
