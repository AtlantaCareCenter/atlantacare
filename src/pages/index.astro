---
import Base from '../layouts/Base.astro';
import Buttons from '../components/Buttons.astro';
import Callout from '../components/Callout.astro';
import Wave from '../components/Wave.astro';
import { md, mdInline, loadSite } from '../lib/md';
import { normalizeHome, single, cssUrl } from '../lib/safe';

await loadSite();
const home = normalizeHome(await single('home'));
const { hero, intro, services, callout } = home;
---
<Base description={home.description}>
  <section class="hero">
    {hero.image && <div class="photo" style={`background-image:${cssUrl(hero.image)}`} aria-hidden="true"></div>}
    <div class="hero-bean" aria-hidden="true"></div>
    <div class="container">
      <div class="content">
        <h1>{hero.heading}<br /><span class="decorative">{hero.script_heading}</span></h1>
        <div class="prose" set:html={md(hero.text)} />
        <Buttons label={hero.button_label} url={hero.button_url} more={hero.buttons} />
      </div>
    </div>
    <Wave />
  </section>

  {(intro.heading || intro.image) && <section class="home-intro">
    <div class="container wide">
      <div>
        <h2 set:html={mdInline(intro.heading)} />
        <Buttons label={intro.button_label} url={intro.button_url} more={intro.buttons} class="button-center" />
      </div>
      {intro.image && <div><img src={intro.image} alt="" width="747" height="708" /></div>}
    </div>
  </section>}

  {(services.heading || services.items.length > 0) && <section class="home-services">
    {services.background_image && <div class="bg" style={`background-image:${cssUrl(services.background_image)}`} aria-hidden="true"></div>}
    <Wave class="top" /><Wave class="bottom" />
    <div class="container wide">
      <h2>{services.heading} <span class="decorative">{services.script_heading}</span></h2>
      <ul class="service-icons">
        {services.items.map((it: any) => (
          <li><a href={it.url || undefined}><h3>{it.title}</h3>{it.icon && <img src={it.icon} alt="" loading="lazy" />}</a></li>
        ))}
      </ul>
      <Buttons label={services.button_label} url={services.button_url} more={services.buttons} class="button-center" />
    </div>
  </section>}

  {callout.heading && <Callout {...callout} />}
</Base>
